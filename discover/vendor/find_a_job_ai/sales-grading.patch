+def _terms_re(terms):
+    return re.compile(r"\b(" + "|".join(re.escape(t) for t in terms) + r")\b", re.I) if terms else None
+
+
+def build_seniority_stretch(profile):
+    """Optional profile["seniority_stretch_terms"]: title words that count as a stretch
+    (default: senior/lead/staff/principal/manager/director/head of). [] disables it."""
+    if "seniority_stretch_terms" not in profile:
+        return SENIORITY_STRETCH
+    return _terms_re(profile["seniority_stretch_terms"])
+
+
+def build_role_family(profile):
+    """Optional profile["role_family"] = {"other": [terms], "adjacent": [terms], "core": [terms]},
+    matched against the job title; with "core" set, a title matching none of it is capped at D. Absent -> the built-in software-engineering heuristics."""
+    rf = profile.get("role_family")
+    if not rf:
+        return None
+    return {"other": _terms_re(rf.get("other")), "adjacent": _terms_re(rf.get("adjacent")),
+            "core": _terms_re(rf.get("core"))}
+
+
