# Copy to .env (git-ignored). Everything here is a path, an address or a spreadsheet id: no secrets.
# Where the dashboard listens. Keep it on loopback or a private (VPN / tailnet) address: the portal has no login.
JOBHUNT_BIND=127.0.0.1
JOBHUNT_PORT=4110
JOBHUNT_DB_PORT=5439
# The mirrored ops data root and résumé workspace on this host (receive-only mirrors of the applying machine).
# The defaults run the kit's synthetic sample data.
JOBHUNT_OPS_HOST_DIR=./sample-data/ops
JOBHUNT_CONTENT_HOST_DIR=./sample-data/content
# The applying machine's zone (Queue "Last touched" is written in it) and the résumé file-name prefix to hide.
JOBHUNT_TZ=UTC
JOBHUNT_RESUME_PREFIX=
# Optional: your self-hosted ATS screener (Library page link) and the two spreadsheet ids (sync reads them with
# the service-account key at JOBHUNT_GOOGLE_SA_HOST_FILE). Empty = files only.
JOBHUNT_ATS_SCANNER_URL=
JOBHUNT_QUEUE_SHEET_ID=
JOBHUNT_JD_SHEET_ID=
JOBHUNT_GOOGLE_SA_HOST_FILE=./secrets/google-sa.json
JOBHUNT_SYNC_INTERVAL=600
JOBHUNT_CDP_HOST=host.docker.internal
JOBHUNT_CDP_PORT=9222
